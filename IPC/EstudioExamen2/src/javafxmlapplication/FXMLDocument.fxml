<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="javafxmlapplication.FXMLDocumentController">
   <children>
      <MenuBar>
        <menus>
          <Menu text="Wallet">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#nueva" text="Nueva">
                     <accelerator>
                        <KeyCodeCombination alt="UP" code="N" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                     </accelerator></MenuItem>
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" onAction="#salir" text="Salir" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="CryptoMoneda">
               <items>
                  <RadioMenuItem fx:id="menuBitCoin" mnemonicParsing="false" onAction="#menuMonedaSelected" text="BitCoin">
                     <toggleGroup>
                        <ToggleGroup fx:id="cryptomonedas" />
                     </toggleGroup>
                  </RadioMenuItem>
                  <RadioMenuItem fx:id="menuEther" mnemonicParsing="false" onAction="#menuMonedaSelected" text="Ether" toggleGroup="$cryptomonedas" />
                  <RadioMenuItem fx:id="menuLiteCoin" mnemonicParsing="false" onAction="#menuMonedaSelected" text="LiteCoin" toggleGroup="$cryptomonedas" />
               </items>
          </Menu>
        </menus>
      </MenuBar>
      <HBox VBox.vgrow="ALWAYS">
         <children>
            <HBox HBox.hgrow="ALWAYS">
               <children>
                  <ListView fx:id="listView" prefHeight="300.0" prefWidth="400.0" HBox.hgrow="SOMETIMES">
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                  </ListView>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="140.0" style="-fx-border-color: black;">
                     <children>
                        <Label fx:id="labelMoneda" text="Label" textFill="RED">
                           <VBox.margin>
                              <Insets bottom="50.0" />
                           </VBox.margin>
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#comprar" prefWidth="65.0" text="Comprar">
                           <VBox.margin>
                              <Insets bottom="15.0" />
                           </VBox.margin>
                        </Button>
                        <Button fx:id="venderButton" minWidth="-Infinity" mnemonicParsing="false" onAction="#vender" prefWidth="65.0" text="Vender" />
                     </children>
                  </VBox>
               </children>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </HBox>
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </HBox>
      <HBox>
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" top="30.0" />
         </VBox.margin>
         <children>
            <Label text="(Gabriela Rego Jamhour GG338978) Selected: " />
            <Label fx:id="selectedMoneda" text="Label" />
         </children>
      </HBox>
   </children>
</VBox>
